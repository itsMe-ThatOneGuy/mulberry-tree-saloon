---
import { Icon } from "astro-icon/components";
import infoBg from "../images/info-bg-green.png";
import { business } from "../data/business.ts";

const mulberryTreeHours = business.mulberryTreeHours;
const cityMorgueHours = business.cityMorgueHours;
---

<section id="info" class="relative scroll-m-8">
    <div
        class="mt-5 bg-[linear-gradient(to_bottom,#1E3D1E,#0D1A0D)] bg-blend-overlay bg-opacity-95 shadow-inner"
        style={`background-image: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0) 20%), linear-gradient(to bottom, #1E3D1E, #0D1A0D), url('${infoBg.src}')`}
    >
        <div class="flex flex-col items-center py-6 px-8 text-white pb-10">
            <h2
                class="font-liquidism2 pb-10 mt-7 font-bold text-[#8B1E1E] text-3xl lg:text-5xl uppercase tracking-widest text-center"
            >
                Information
            </h2>

            <div
                class="w-full max-w-screen-xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16"
            >
                <div class="flex flex-col items-center">
                    <div class="w-full">
                        <iframe
                            class="w-full h-64 lg:h-120 rounded-md shadow-lg"
                            title="Google Map"
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6373.141844684716!2d-93.63045578181291!3d36.99617396565907!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87cf4eda7f665649%3A0xbeb42b2f2611bf8e!2s610%20State%20Hwy%20265%2C%20Marionville%2C%20MO%2065705!5e0!3m2!1sen!2sus!4v1683601716692!5m2!1sen!2sus"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                        ></iframe>
                    </div>

                    <div
                        class="flex flex-col items-center pt-6 text-center max-w-md"
                    >
                        <p
                            class="text-lg md:text-xl font-medium mb-4 text-[#F0F7EE]"
                        >
                            Visit our Facebook or Instagram page for all
                            upcoming events!
                        </p>
                        <div class="flex justify-center gap-4">
                            <a
                                href={business.facebook}
                                target="_blank"
                                rel="noreferrer"
                            >
                                <button
                                    class="bg-[#1a1a1a] hover:bg-[#2a2a2a] p-3 rounded-full text-[#8B1E1E] transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-[#71C13F]"
                                >
                                    <Icon name="facebook" size={28} />
                                </button>
                            </a>
                            <a
                                href={business.instagram}
                                target="_blank"
                                rel="noreferrer"
                            >
                                <button
                                    class="bg-[#1a1a1a] hover:bg-[#2a2a2a] p-3 rounded-full text-[#C86368] transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-[#71C13F]"
                                >
                                    <Icon name="instagram" size={28} />
                                </button>
                            </a>
                        </div>
                    </div>
                </div>

                <div
                    class="space-y-10 text-center text-lg sm:text-xl font-medium"
                >
                    <div class="space-y-1">
                        <Icon
                            name="mappin"
                            class="text-[#71C13F] mx-auto mb-1"
                            size={24}
                        />
                        <p class="text-[#C86368] uppercase font-semibold">
                            Location
                        </p>
                        <a
                            href="https://maps.app.goo.gl/p4CYDnyUPcvWwQPi7"
                            target="_blank"
                            rel="noreferrer"
                            class="hover:underline decoration-[#71C13F]"
                        >
                            {business.address.streetAddress}
                            <br />
                            {business.address.addressLocality}, {
                                business.address.addressRegion
                            }&nbsp
                            {business.address.postalCode}
                        </a>
                    </div>

                    <div class="space-y-1">
                        <Icon
                            name="phone"
                            class="text-[#71C13F] mx-auto mb-1"
                            size={24}
                        />
                        <p class="text-[#C86368] uppercase font-semibold">
                            Phone
                        </p>
                        <a
                            href={`tel:${business.telephone}`}
                            class="hover:underline decoration-[#71C13F]"
                        >
                            {business.telephoneDisplay}
                        </a>
                    </div>

                    <div class="space-y-1">
                        <Icon
                            name="email"
                            class="text-[#71C13F] mx-auto mb-1"
                            size={24}
                        />
                        <p class="text-[#C86368] uppercase font-semibold">
                            Email
                        </p>
                        <a
                            href={`mailto:${business.email}`}
                            class="hover:underline decoration-[#71C13F]"
                        >
                            {business.email}
                        </a>
                    </div>

                    <div class="pt-5 mt-5 border-t border-[#8B1E1E]/40"></div>

                    <div class="space-y-4 text-center max-w-md mx-auto">
                        <div class="pb-4">
                            <Icon
                                name="clock"
                                class="text-[#71C13F] mx-auto mb-2"
                                size={24}
                            />
                            <p class="text-[#C86368] uppercase font-semibold">
                                Hours of Operation
                            </p>
                        </div>

                        <p class="pb-2 tracking-wider text-[#F0F7EE]">
                            Mulberry Tree Saloon
                        </p>

                        <div class="space-y-2">
                            {
                                mulberryTreeHours.map(
                                    ({ day, hours, color, closed }) => (
                                        <div class="flex justify-between">
                                            <p
                                                class={`font-medium ${color ? `text-[${color}]` : ""}`}
                                            >
                                                {day}
                                            </p>
                                            <p
                                                class={`tracking-wide ${
                                                    closed
                                                        ? "font-liquidism2 text-[#8B1E1E]"
                                                        : ""
                                                }`}
                                            >
                                                {hours}
                                            </p>
                                        </div>
                                    ),
                                )
                            }
                        </div>
                        <div
                            class="flex justify-between text-sm md:text-base border-b border-[#71C13F]/40 pb-2"
                        >
                        </div>

                        <p
                            class="pt-4 font-liquidism2 tracking-wider text-[#F0F7EE]"
                        >
                            The City Morgue Restaurant
                        </p>
                        <div class="space-y-2">
                            {
                                cityMorgueHours.map(
                                    ({ day, hours, color, closed }) => (
                                        <div class="flex justify-between">
                                            <p
                                                class={`font-medium ${color ? `text-[${color}]` : ""}`}
                                            >
                                                {day}
                                            </p>
                                            <p
                                                class={`tracking-wide ${
                                                    closed
                                                        ? "font-liquidism2 text-[#8B1E1E]"
                                                        : ""
                                                }`}
                                            >
                                                {hours}
                                            </p>
                                        </div>
                                    ),
                                )
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
