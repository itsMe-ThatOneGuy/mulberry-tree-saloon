---
import { Icon } from "astro-icon/components";
import { business } from "../data/business.ts";
---

<footer>
    <div
        class="relative w-full flex flex-col lg:flex-row justify-between items-center px-6 py-4 text-[#F0F7EE] font-medium md:text-lg bg-linear-to-r from-black via-[#1a001f] to-black shadow-lg shadow-[#3b0764]/30 border-t border-[#3b0764]/50"
    >
        <div class="mb-2 lg:mb-0 lg:ml-0 text-lg">
            <a
                href="/"
                class="font-liquidism2 text-[#F0F7EE] hover:text-[#47A025] transition-all ease-in-out duration-300"
            >
                M<span class="font-liquidism text-[#47A025]">T</span>S
            </a>
        </div>

        <div class="text-center">
            <div
                class="flex flex-col lg:flex-row items-center justify-center gap-1"
            >
                <div class="flex">
                    <p class="pr-1">© {new Date().getFullYear()}</p>
                    <p class="pr-1 hidden lg:inline">&middot;</p>
                </div>
                <p>
                    Mulberry{" "}
                    <span class="font-liquidism2 tracking-wide text-[#47A025]">
                        Tree
                    </span>{" "}
                    Saloon
                </p>
            </div>
            <p class="text-sm opacity-70">All rights reserved</p>
            <div class="text-sm opacity-70 flex flex-col lg:flex-row p-2">
                <p>Design and Development By &nbsp</p>
                <a href="https://github.com/itsMe-ThatOneGuy" target="_blank"
                    >Matthew Smart</a
                >
            </div>
        </div>

        <div class="flex mt-2 lg:mt-0 space-x-4">
            <a
                href={business.facebook}
                target="_blank"
                rel="noreferrer"
                class="hover:text-blue-600 transition-colors duration-300"
            >
                <Icon name="facebook" size={26} />
            </a>
            <a
                href={business.instagram}
                target="_blank"
                rel="noreferrer"
                class="hover:text-[#DD2A7B] transition-colors duration-300"
            >
                <Icon name="instagram" size={26} />
            </a>
        </div>
    </div>
</footer>
