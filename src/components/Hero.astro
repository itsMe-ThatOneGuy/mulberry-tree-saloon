---
import { Icon } from "astro-icon/components";
import { business } from "../data/business";
import heroBgFull from "../images/hero-bg-full.webp";
import heroBgMobile from "../images/hero-bg-mobile.webp";
---

<section class="h-screen flex items-center relative z-30" id="top">
    <div
        class="hero-background w-full h-full bg-cover shadow-inner"
        style={`--hero-mobile: url('${heroBgMobile.src}'); --hero-full: url('${heroBgFull.src}');`}
    >
        <div
            class="h-full w-full bg-black/60 text-[#F0F7EE] flex flex-col justify-center items-center px-4 text-center shadow-inner relative overflow-hidden"
        >
            <h1
                class="text-4xl md:text-6xl lg:text-8xl font-bold uppercase tracking-widest drop-shadow"
            >
                Mulberry Tree Saloon
            </h1>

            <h2
                class="text-xl md:text-3xl lg:text-4xl uppercase pt-6 tracking-wider text-[#B0C4B1] drop-shadow-md"
            >
                Home of
            </h2>

            <h3
                class="text-[#8B1E1E] font-liquidism2 text-4xl md:text-5xl lg:text-7xl pt-4 uppercase animate-flicker"
            >
                The City Morgue Restaurant
            </h3>

            <div class="pt-10 hover:scale-105 transition-all duration-300">
                <a
                    href={business.menu}
                    target="_blank"
                    class="relative px-4 py-2 lg:px-8 lg:py-4 lg:text-lg uppercase font-bold tracking-widest rounded border-2 text-[#F0F7EE] hover:text-[#8B1E1E] border-[#8B1E1E] shadow-md transition-all duration-300 hover:shadow-[0_0_20px_rgba(139,30,30,0.8)]"
                    style={{
                        background: "rgba(0, 0, 0, 0.7)",
                        textShadow: "0 0 3px #8B1E1E",
                    }}
                >
                    <span class="relative z-10">View the Menu</span>
                    <span
                        class="absolute inset-0 rounded animate-flicker"
                        style={{
                            boxShadow: "0 0 15px #8B1E1E",
                            opacity: 0.2,
                        }}></span>
                </a>
            </div>

            <div class="absolute bottom-24">
                <a
                    href="#about"
                    class="flex flex-col items-center text-[#71C13F] hover:opacity-80"
                >
                    <Icon name="chevron-down" class="w-8 h-8 animate-bounce" />
                    <span class="text-xs uppercase tracking-widest mt-1">
                        Scroll
                    </span>
                </a>
            </div>
        </div>
    </div>
</section>
