---
interface Props {
    images: {
        src: string;
        alt: string;
    }[];
    interval?: number;
}

const { images, interval = 4000 } = Astro.props;

const carouselImages = [...images, ...images.slice(0, 3)];
---

<div
    class="carousel relative w-full overflow-hidden"
    data-image-count={images.length}
>
    <div
        id="carousel-track"
        class="flex transition-transform duration-700 ease-in-out"
    >
        {
            carouselImages.map((image) => (
                <div class="carousel-slide w-full shrink-0 px-2 md:w-1/2 lg:w-1/3">
                    <button
                        type="button"
                        class="group block w-full cursor-zoom-in"
                        data-lightbox-image={image.src}
                        data-lightbox-alt={image.alt}
                        aria-label={`Enlarge ${image.alt}`}
                    >
                        <img
                            src={image.src}
                            alt={image.alt}
                            class="h-120 w-full rounded-lg object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                        />
                    </button>
                </div>
            ))
        }
    </div>
</div>
<div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Image preview"
>
    <button
        id="lightbox-close"
        type="button"
        class="absolute right-5 top-5 z-10 cursor-pointer text-4xl text-white transition-colors hover:text-[#47A025]"
        aria-label="Close image"
    >
        &times;
    </button>

    <img
        id="lightbox-image"
        src=""
        alt=""
        class="max-h-[90vh] max-w-[95vw] object-contain"
    />
</div>
<script define:vars={{ interval }}>
    const carousel = document.querySelector(".carousel");
    const track = carousel?.querySelector("#carousel-track");

    if (carousel && track) {
        const originalImageCount = Number(carousel.dataset.imageCount);

        let position = 0;
        let visibleImages = 3;

        const getVisibleImages = () => {
            if (window.innerWidth >= 1024) {
                return 3;
            }

            if (window.innerWidth >= 768) {
                return 2;
            }

            return 1;
        };

        const updatePosition = (animate = true) => {
            visibleImages = getVisibleImages();

            track.style.transition = animate
                ? "transform 700ms ease-in-out"
                : "none";

            track.style.transform = `translateX(-${position * (100 / visibleImages)}%)`;
        };

        const advance = () => {
            position++;

            updatePosition();

            if (position >= originalImageCount) {
                setTimeout(() => {
                    position = 0;
                    updatePosition(false);
                }, 700);
            }
        };

        updatePosition(false);

        setInterval(advance, interval);

        window.addEventListener("resize", () => {
            updatePosition(false);
        });
    }

    const lightbox = document.querySelector("#lightbox");
    const lightboxImage = document.querySelector("#lightbox-image");
    const lightboxClose = document.querySelector("#lightbox-close");

    const openLightbox = (src, alt) => {
        if (!lightbox || !lightboxImage) return;

        lightboxImage.src = src;
        lightboxImage.alt = alt;

        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");

        document.body.classList.add("overflow-hidden");
    };

    const closeLightbox = () => {
        if (!lightbox || !lightboxImage) return;

        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");

        lightboxImage.src = "";
        document.body.classList.remove("overflow-hidden");
    };

    document.querySelectorAll("[data-lightbox-image]").forEach((button) => {
        button.addEventListener("click", () => {
            const src = button.dataset.lightboxImage;
            const alt = button.dataset.lightboxAlt ?? "";

            if (src) {
                openLightbox(src, alt);
            }
        });
    });

    lightboxClose?.addEventListener("click", closeLightbox);

    lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) {
            closeLightbox();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeLightbox();
        }
    });
</script>
