---
import { Icon } from "astro-icon/components";
import { business } from "../data/business";

const NAV_LINKS = [
    {
        label: "About",
        to: "#about",
        font: "font-liquidism2",
        decoration: "#47A025",
    },
    {
        label: "Menu",
        to: business.menu,
        target: 'target="_blank"',
        font: "font-zomboi",
        decoration: "#E71D36",
    },
    {
        label: "Info",
        to: "#info",
        font: "font-liquidism2",
        decoration: "#47A025",
    },
];
---

<header
    id="site-header"
    class={`fixed top-0 left-0 z-50 w-full transition-transform duration-300 shadow-lg shadow-[#3b0764]/30 data-[visible=true]:translate-y-0 data-[visible=false]:-translate-y-full`}
>
    <div
        id="nav-container"
        class={`flex w-full bg-linear-to-r from-black via-[#1a001f] to-black items-center justify-between px-6 py-4 z-40 data-[sticky=true]:shadow-md`}
    >
        <a
            href="/"
            class="font-liquidism2 text-3xl font-medium tracking-widest text-[#F0F7EE] hover:text-[#47A025] transition-all ease-in-out duration-300 z-50"
        >
            M<span class="font-liquidism text-[#47A025]">T</span>S
        </a>

        <nav class="hidden sm:flex space-x-7">
            {
                NAV_LINKS.map(({ label, to, target, font }) => (
                    <a
                        href={to}
                        {target}
                        class={`${font} text-3xl tracking-widest text-[#F0F7EE] font-medium uppercase cursor-pointer transition-all ease-in-out duration-300 hover:text-[#47A025]`}
                    >
                        {label}
                    </a>
                ))
            }
        </nav>

        <button
            id="menu-button"
            class="text-[#F0F7EE] cursor-pointer sm:hidden z-50 text-3xl"
            aria-label="Toggle mobile menu"
        >
            <Icon
                name="menu"
                id="open-button"
                class="hover:text-[#47A025] transition-all duration-300"
            />
            <Icon
                name="close"
                id="close-button"
                class="hidden hover:text-[#47A025] transition-all duration-300"
            />
        </button>
    </div>

    <div
        id="mobile-menu"
        class={`mobile-menu-container data-[visible=true]:opacity-100 data-[visible=true]:pointer-events-auto text-3xl backdrop-blur-sm bg-black/80`}
    >
        <ul
            id="mobile-nav"
            class={`flex flex-col items-center justify-center pt-28 space-y-14 text-[#F0F7EE] text-3xl transition-all duration-500 ease-in-out transform
                data-[visible=false]:opacity-0 -translate-y-8`}
        >
            {
                NAV_LINKS.map(({ label, to, target, font, decoration }) => (
                    <li>
                        <a
                            href={to}
                            {target}
                            class={`nav-link ${font} tracking-widest underline underline-offset-8 decoration-[${decoration}] hover:text-[#47A025] transition-all duration-300 drop-shadow-md`}
                        >
                            {label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
    <div
        class="absolute -bottom-3 left-0 w-full h-8 blur-xl bg-[#5B0A91] opacity-60 pointer-events-none z-[-1]"
    >
    </div>
</header>
<script>
    //Header stuff
    let isSticky = false;
    let isHeaderVisible = true;

    const headerElement = document.querySelector("#site-header");
    const navContainerElement = document.querySelector("#nav-container");
    let lastScrollY = window.scrollY;

    const handleScroll = () => {
        const currentScrollY = window.scrollY;

        isSticky = window.scrollY > 0;
        navContainerElement.dataset.sticky = String(isSticky);

        isHeaderVisible = currentScrollY <= 0 || currentScrollY < lastScrollY;
        headerElement.dataset.visible = String(isHeaderVisible);

        lastScrollY = currentScrollY;
    };

    window.addEventListener("scroll", handleScroll);

    //mobile nav stuff
    let mobileMenu = false;

    const mobileMenuElement = document.querySelector("#mobile-menu");
    mobileMenuElement.setAttribute("aria-expanded", mobileMenu);

    const mobileNavElement = document.querySelector("#mobile-nav");
    const navLinks = document.querySelectorAll(".nav-link");

    const menuButton = document.querySelector("#menu-button");
    const openIcon = document.querySelector("#open-button");
    const closeIcon = document.querySelector("#close-button");

    const body = document.querySelector("body");

    const updateMobileMenu = () => {
        mobileMenu = !mobileMenu;
        body.classList.toggle("active");

        mobileMenuElement.dataset.visible = String(mobileMenu);
        mobileMenuElement.setAttribute("aria-expanded", mobileMenu);

        mobileNavElement.dataset.visible = String(mobileMenu);
    };

    const updateButton = () => {
        openIcon.classList.toggle("hidden");
        closeIcon.classList.toggle("hidden");
    };

    menuButton?.addEventListener("click", () => {
        updateMobileMenu();
        updateButton();
    });

    navLinks.forEach((elm) => {
        elm.addEventListener("click", () => {
            updateMobileMenu();
            updateButton();
        });
    });
</script>
